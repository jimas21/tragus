[Desktop Entry]
Type=Application
Name=Install Tragus
Comment=Installs or updates Tragus (earbuds battery, noise control and ear detection) on this Steam Frame
Icon=system-software-install
Exec=konsole --hold -e python3 -I -c "import sys,urllib.request as u; sys.excepthook=lambda *e: print('Could not download the Tragus installer. Check that the headset is online, then try again.'); exec(u.urlopen('https://github.com/jimas21/tragus/releases/latest/download/magicpods-frame-install.py', timeout=60).read())"
Terminal=false
