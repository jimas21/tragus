[Desktop Entry]
Type=Application
Name=Uninstall Tragus
Comment=Removes Tragus from this Steam Frame (your headphone settings are kept)
Icon=edit-delete
Exec=konsole --hold -e python3 -I -c "import urllib.request as u; exec(u.urlopen('https://github.com/jimas21/tragus/releases/latest/download/magicpods-frame-install.py', timeout=60).read())" --uninstall
Terminal=false
