[Desktop Entry]
Type=Application
Name=Uninstall Tragus
Comment=Removes Tragus from this Steam Frame (your headphone settings are kept)
Icon=edit-delete
Exec=konsole --hold -e sh -c "curl -fsSL https://github.com/jimas21/tragus/releases/latest/download/magicpods-frame-install.py -o /tmp/magicpods-frame-install.py && python3 -I /tmp/magicpods-frame-install.py --uninstall"
Terminal=false
